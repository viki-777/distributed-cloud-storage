{
  "title": "Cluster Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Active Nodes",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "dcs_active_nodes_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Chunks Stored",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(dcs_node_chunks_stored)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Under-Replicated Chunks",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "dcs_under_replicated_chunks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Heal Events",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "dcs_heal_events_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upload Operations Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "rate(dcs_upload_operations_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Global Disk Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(dcs_node_disk_used_bytes)",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "sum(dcs_node_disk_free_bytes)",
          "legendFormat": "Free",
          "refId": "B"
        }
      ]
    }
  ]
}
